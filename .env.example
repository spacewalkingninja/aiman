# aiman configuration (all optional — sensible defaults are used)

# Base directory for aiman's own data (manager.db, backups).
# AIMAN_HOME=/home/you/.local/share/aiman

# HTTP server
HOST=127.0.0.1
PORT=4097

# The opencode server the manager talks to.
OPENCODE_URL=http://127.0.0.1:4096

# opencode's SQLite database and auth file (auto-detected per platform).
# OPENCODE_DB=/home/you/.local/share/opencode/opencode.db
# OPENCODE_AUTH=/home/you/.local/share/opencode/auth.json

# Optional pyxtermjs terminal backend.
TERMINAL_URL=http://127.0.0.1:4098

# Built web UI directory (defaults to <repo>/dist).
# DIST=/path/to/dist
